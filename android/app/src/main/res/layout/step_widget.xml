<?xml version="1.0" encoding="utf-8"?>
<!-- Centered vertical layout: reads well both as a compact square tile and
     stretched into a wide rectangle, so one layout covers both shapes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_widget_walk" />

    <TextView
        android:id="@+id/widget_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0"
        android:textColor="#F1F5E9"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="of 8,000 steps"
        android:textColor="#8FB0A0"
        android:textSize="12sp" />
</LinearLayout>
